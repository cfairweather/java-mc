# Server settings shared by local compose and the AWS ECS task definition.
# Everything here maps to itzg/minecraft-server environment variables:
#   https://docker-minecraft-server.readthedocs.io/
# Secrets (RCON_PASSWORD, RESTIC_PASSWORD) never go here. Locally they live in
# .env (git-ignored); on AWS they come from SSM Parameter Store.
# Minecraft VERSION and FABRIC_LOADER_VERSION live in mods/versions.env.

EULA=TRUE
TYPE=FABRIC
TZ=America/Los_Angeles

# --- Access control ----------------------------------------------------------
# Only Mojang/Microsoft-authenticated accounts, only whitelisted names.
ONLINE_MODE=true
ENFORCE_SECURE_PROFILE=true
ENABLE_WHITELIST=true
ENFORCE_WHITELIST=true
# Comma-separated Minecraft usernames. Add a friend here, then `make deploy`
# (AWS) or `make up` (local). `make whitelist-add NAME=x` also adds live.
WHITELIST=cfairweather
# Operators (level 4). Keep this to yourself.
OPS=cfairweather
# Merge the lists above into the existing whitelist/ops files on every start,
# so players added live over RCON are kept.
EXISTING_WHITELIST_FILE=SYNC_FILE_MERGE_LIST
EXISTING_OPS_FILE=SYNC_FILE_MERGE_LIST

# --- World -------------------------------------------------------------------
LEVEL=world
# SEED=
DIFFICULTY=easy
MODE=survival
PVP=true
HARDCORE=false
MAX_PLAYERS=20
SPAWN_PROTECTION=0
VIEW_DISTANCE=12
SIMULATION_DISTANCE=8
ALLOW_FLIGHT=true
ENABLE_COMMAND_BLOCK=false
MOTD=A private world for friends. Mods: %MODPACK_VERSION%
# Gamerules are applied over RCON after every start (idempotent).
RCON_CMDS_STARTUP=gamerule keepInventory true\ngamerule playersSleepingPercentage 1
# Stop ticking when nobody is online (saves CPU). Wakes instantly on join.
PAUSE_WHEN_EMPTY_SECONDS=300

# --- Mods --------------------------------------------------------------------
# MODRINTH_PROJECTS is set by compose / terraform from SERVER_PROFILE.
MODRINTH_DOWNLOAD_DEPENDENCIES=required
# Remove mods from /data/mods that are no longer in the listing.
REMOVE_OLD_MODS=false
# Repo config files win over anything edited inside the container.
SYNC_SKIP_NEWER_IN_DESTINATION=false

# --- JVM / runtime -----------------------------------------------------------
MEMORY=8G
USE_AIKAR_FLAGS=true
ENABLE_RCON=true
RCON_PORT=25575
ENABLE_ROLLING_LOGS=true
LOG_TIMESTAMP=true
STOP_SERVER_ANNOUNCE_DELAY=10

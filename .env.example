# Copy to .env for local development. .env is git-ignored.

# Secrets
RCON_PASSWORD=change-me-rcon
RESTIC_PASSWORD=change-me-restic

# core = server-side mods only, vanilla clients can join
# full = adds content mods, everyone installs the client pack (default)
SERVER_PROFILE=full

# Local override of the heap size (server.env sets 8G for the AWS host).
MEMORY=4G

# Local backup destination (a restic repo on disk). On AWS this is S3.
RESTIC_REPOSITORY=/backups/restic
